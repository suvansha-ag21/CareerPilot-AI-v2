generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  USER
  ADMIN
}

enum SkillCategory {
  CORE_CS
  FRONTEND
  BACKEND
  DATABASE
  AI_ML
  DEVOPS
  SOFT_SKILL
}

enum ProficiencyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum SkillSource {
  PROFILE
  RESUME_PARSED
  INTERVIEW_EVAL
}

enum ResumeFileType {
  PDF
  DOCX
}

enum InterviewCategory {
  TECHNICAL
  HR
  DSA
  JAVA
  PYTHON
  SQL
  FULL_STACK
  PROJECT_BASED
  BEHAVIORAL
  MIXED
}

enum InterviewDifficulty {
  EASY
  MEDIUM
  HARD
}

enum InterviewMode {
  TEXT
  VOICE
}

enum InterviewStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum TaskPriority {
  HIGH
  MEDIUM
  LOW
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum ApplicationStatus {
  APPLIED
  ASSESSMENT
  SHORTLISTED
  INTERVIEW_SCHEDULED
  SELECTED
  REJECTED
  OFFER_RECEIVED
}

enum JobType {
  INTERNSHIP
  FULL_TIME
  PART_TIME
  REMOTE
  ON_SITE
  HYBRID
}

// ============================================
// IDENTITY, PROFILE & NORMALIZED RECORDS
// ============================================

model User {
  id                String   @id @default(uuid()) @db.Uuid
  name              String
  email             String   @unique
  passwordHash      String
  role              UserRole @default(USER)
  profileImage      String?
  headline          String?
  targetRole        String   @default("Full Stack Developer")
  yearsExperience   Int      @default(0)
  location          String?
  githubUrl         String?
  linkedinUrl       String?
  careerPreferences Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  educations          Education[]
  workExperiences     WorkExperience[]
  projects            CandidateProject[]
  skills              UserSkill[]
  resumes             Resume[]
  jobMatches          JobMatch[]
  learningRoadmaps    LearningRoadmap[]
  interviews          Interview[]
  jobApplications     JobApplication[]
  githubAnalyses      GitHubRepoAnalysis[]
  flashcardDrills     FlashcardDrill[]
  aiTelemetryLogs     AiTelemetryLog[]

  @@index([email])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Education {
  id           String  @id @default(uuid()) @db.Uuid
  userId       String  @db.Uuid
  institution  String
  degree       String
  fieldOfStudy String?
  startYear    Int?
  endYear      Int?
  grade        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WorkExperience {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  company     String
  roleTitle   String
  startDate   String?
  endDate     String?
  isCurrent   Boolean  @default(false)
  description String?  @db.Text
  highlights  String[] @default([])

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CandidateProject {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  title       String
  techStack   String[] @default([])
  description String   @db.Text
  repoUrl     String?
  liveUrl     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================
// NORMALIZED SKILLS TAXONOMY
// ============================================

model Skill {
  id             String        @id @default(uuid()) @db.Uuid
  name           String
  normalizedName String        @unique
  category       SkillCategory @default(CORE_CS)

  userSkills UserSkill[]

  @@index([category])
}

model UserSkill {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String           @db.Uuid
  skillId          String           @db.Uuid
  proficiencyLevel ProficiencyLevel @default(INTERMEDIATE)
  source           SkillSource      @default(PROFILE)
  confidenceScore  Int              @default(60)
  updatedAt        DateTime         @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([userId, proficiencyLevel])
}

// ============================================
// AI RESUME ANALYZER & JOB MATCHER
// ============================================

model Resume {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @db.Uuid
  title          String
  fileUrl        String
  fileType       ResumeFileType @default(PDF)
  extractedText  String         @db.Text
  parsedData     Json
  skills         String[]       @default([])
  estimatedScore Float          @default(0)
  sectionScores  Json
  feedback       Json
  isPrimary      Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobMatches JobMatch[]
  interviews Interview[]

  @@index([userId, createdAt])
}

model JobMatch {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  resumeId         String   @db.Uuid
  targetRole       String
  companyName      String?
  jobDescription   String   @db.Text
  matchScore       Float
  semanticScore    Float
  skillScore       Float
  experienceScore  Float
  matchingSkills   String[] @default([])
  partialSkills    String[] @default([])
  missingSkills    String[] @default([])
  relevantProjects Json
  recommendations  Json
  createdAt        DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ============================================
// PERSONALIZED LEARNING ROADMAP
// ============================================

model LearningRoadmap {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  targetRole     String
  title          String
  estimatedWeeks Int      @default(4)
  progressPct    Float    @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks RoadmapTask[]

  @@index([userId, isActive])
}

model RoadmapTask {
  id          String       @id @default(uuid()) @db.Uuid
  roadmapId   String       @db.Uuid
  weekNumber  Int          @default(1)
  dayNumber   Int          @default(1)
  title       String
  description String       @db.Text
  skillTag    String
  priority    TaskPriority @default(MEDIUM)
  resources   Json
  status      TaskStatus   @default(PENDING)
  dueDate     DateTime?
  completedAt DateTime?

  roadmap LearningRoadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@index([roadmapId, weekNumber, status])
}

// ============================================
// AI MOCK & VOICE INTERVIEWS
// ============================================

model Interview {
  id                   String              @id @default(uuid()) @db.Uuid
  userId               String              @db.Uuid
  resumeId             String?             @db.Uuid
  githubRepoId         String?             @db.Uuid
  category             InterviewCategory   @default(TECHNICAL)
  targetRole           String?
  subcategories        String[]            @default([])
  difficulty           InterviewDifficulty @default(MEDIUM)
  mode                 InterviewMode       @default(TEXT)
  durationMinutes      Int                 @default(20)
  questionLimit        Int                 @default(5)
  targetJobDescription String?             @db.Text
  status               InterviewStatus     @default(IN_PROGRESS)
  overallScore         Float?
  feedbackSummary      Json?
  createdAt            DateTime            @default(now())
  completedAt          DateTime?

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume     Resume?             @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  githubRepo GitHubRepoAnalysis? @relation(fields: [githubRepoId], references: [id], onDelete: SetNull)
  questions  InterviewQuestion[]

  @@index([userId, createdAt])
}

model InterviewQuestion {
  id             String    @id @default(uuid()) @db.Uuid
  interviewId    String    @db.Uuid
  questionOrder  Int
  question       String    @db.Text
  topicTag       String
  userAnswer        String?   @db.Text
  audioUrl          String?
  speechMetrics     Json?
  submissionContext Json?
  modelAnswer       String    @db.Text
  score          Float?
  criteriaScores Json?
  feedback       String?   @db.Text
  isFollowUp     Boolean   @default(false)
  createdAt      DateTime  @default(now())
  answeredAt     DateTime?

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@unique([interviewId, questionOrder])
  @@index([interviewId, questionOrder])
}

// ============================================
// JOB APPLICATION TRACKER
// ============================================

model JobApplication {
  id              String            @id @default(uuid()) @db.Uuid
  userId          String            @db.Uuid
  company         String
  jobRole         String
  jobType         JobType           @default(FULL_TIME)
  jobDescription  String?           @db.Text
  applicationDate DateTime          @default(now())
  status          ApplicationStatus @default(APPLIED)
  interviewDate   DateTime?
  applicationUrl  String?
  notes           String?           @db.Text
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, applicationDate])
}

// ============================================
// GITHUB PROJECT CODE ANALYZER
// ============================================

model GitHubRepoAnalysis {
  id                     String   @id @default(uuid()) @db.Uuid
  userId                 String   @db.Uuid
  repoUrl                String
  owner                  String
  repoName               String
  description            String?  @db.Text
  defaultBranch          String   @default("main")
  primaryLanguage        String?
  stars                  Int      @default(0)
  detectedStack          String[] @default([])
  architectureHighlights String[] @default([])
  interviewHooks         String[] @default([])
  summary                String   @db.Text
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  interviews Interview[]

  @@unique([userId, owner, repoName])
  @@index([userId, updatedAt])
}

// ============================================
// SPACED-REPETITION MICRO-DRILLS
// ============================================

model FlashcardDrill {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  topic          String
  question       String    @db.Text
  hint           String?   @db.Text
  modelAnswer    String    @db.Text
  source         String    @default("MANUAL")
  easeFactor     Float     @default(2.5)
  intervalDays   Int       @default(1)
  repetitions    Int       @default(0)
  nextReviewAt   DateTime  @default(now())
  lastReviewedAt DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, nextReviewAt])
}

// ============================================
// AI OBSERVABILITY & PIPELINE TELEMETRY
// ============================================

model AiTelemetryLog {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @db.Uuid
  operation    String
  provider     String
  model        String
  latencyMs    Int
  fallbackUsed Boolean  @default(false)
  success      Boolean  @default(true)
  errorCode    String?
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
}
