{
  "name": "careerpilot-ai",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shared",
    "frontend"
  ],
  "scripts": {
    "build": "npm --workspace=frontend run build && cd backend && .\\mvnw.cmd package -DskipTests",
    "build:backend": "cd backend && .\\mvnw.cmd package -DskipTests",
    "build:frontend": "npm --workspace=frontend run build",
    "test:backend": "cd backend && .\\mvnw.cmd test",
    "test:ai": "cd ai-service && python -m unittest discover -s tests",
    "test:all": "npm run test:backend && npm run test:ai",
    "dev:backend": "cd backend && .\\mvnw.cmd spring-boot:run",
    "start:backend": "cd backend && java -jar target/backend-1.0.0.jar",
    "dev:frontend": "npm --workspace=frontend run dev",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build"
  }
}
