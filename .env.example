# ==========================================
# CareerPilot AI - Environment Configuration
# ==========================================

# PostgreSQL (Docker uses port 5432, local pgdata uses 5433)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=careerpilot_dev_pass
POSTGRES_DB=careerpilot_db
DATABASE_URL="postgresql://postgres:careerpilot_dev_pass@127.0.0.1:5433/careerpilot_db?schema=public"

# Node.js + Express Backend
PORT=5000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"
JWT_ACCESS_SECRET="replace-with-strong-32-char-access-secret"
JWT_REFRESH_SECRET="replace-with-strong-32-char-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_DAYS=7
INTERNAL_SERVICE_KEY="replace-with-strong-internal-service-hmac-key"
AI_SERVICE_URL="http://127.0.0.1:8000"
STORAGE_DIR="./storage"

# Optional Cloudinary Private Storage (production object storage)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Python FastAPI AI Microservice
AI_PORT=8000
CHROMA_PERSIST_DIR="../database/chroma_data"
LLM_PROVIDER="gemini"
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"
OPENAI_API_KEY=""
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"

# Next.js Frontend
NEXT_PUBLIC_API_URL="http://localhost:5000/api"
