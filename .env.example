# Local Compose settings. Replace every sample secret before production deployment.
POSTGRES_USER=careerpilot
POSTGRES_PASSWORD=local-only-change-me
POSTGRES_DB=careerpilot_db

JWT_ACCESS_SECRET=local-only-access-secret-change-before-deploy-0123456789
JWT_REFRESH_SECRET=local-only-refresh-secret-change-before-deploy-9876543210
INTERNAL_SERVICE_KEY=local-only-internal-key-change-before-deploy

# AI Service / LLM Settings
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=

# Local development URLs; production Compose builds the frontend API URL from APP_DOMAIN.
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Set this in the production .env file to the domain served by Caddy.
APP_DOMAIN=careerpilot.example.com
